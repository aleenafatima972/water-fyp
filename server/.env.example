PORT=3001
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Secret the ESP32 sends in the X-Device-Key header (generate it the same way)
DEVICE_KEY=change-me
# Optional: the server fetches readings from the ESP32 itself (IP or water-esp32.local).
# Use this when the firewall blocks the ESP32 from POSTing to the server.
# ESP32_HOST=192.168.100.64
